# Do repozytorium (GitHub Pages) trafia tylko gotowa strona.
# Tekst .md, generator (tools/), brief, korekty i oryginały szkiców zostają lokalnie.
*
!*/

!/.gitignore
!/.nojekyll
!/index.html
!/style.css
!/script.js

!/favicon.svg
!/nie-kazdy-kto-byl-na-szczycie.pdf
!/sitemap.xml
!/feed.xml
!/nie-kazdy-kto-byl-na-szczycie.epub
!/robots.txt

# Strony rozdziałów z podglądem linku (np. pilsko/index.html)
!/*/index.html

!/fonts/*
!/assets/web/*
!/assets/og/*
