# Do repozytorium (GitHub Pages) trafia tylko gotowa strona.
# Tekst .md, generator (tools/), robocze/ i oryginały zdjęć zostają lokalnie.
*
!*/

!/.gitignore
!/.nojekyll
!/index.html
!/404.html
!/style.css
!/script.js
!/efekty.js
!/efekty.css

!/favicon.svg
!/nie-kazdy-kto-byl-na-szczycie.pdf
!/sitemap.xml
!/feed.xml
!/nie-kazdy-kto-byl-na-szczycie.epub
!/robots.txt

# Strony rozdziałów z podglądem linku — wypisane z nazwy, bo wzorzec !/*/index.html
# wpuszczałby każdy nowy katalog w głównym folderze. Kolejność jak w SLUGS.
!/pilsko/index.html
!/dolina-pieciu-stawow/index.html
!/kozi-wierch/index.html
!/mnich/index.html
!/marmolada/index.html
!/everest/index.html
!/babia-gora/index.html
!/rysy/index.html
!/gran-paradiso/index.html
!/skalka/index.html
!/grossglockner/index.html
!/mont-blanc/index.html

!/fonts/*
!/assets/web/*
!/assets/og/*

# Muzyka do czytania — tylko przekonwertowane pliki, nie oryginały z assets/
!/assets/audio/*
# Tła rozdziałów: gotowe pętle (75–220 s, ok. 1–2,6 MB). Oryginały w assets/audio/background/ zostają lokalnie.
!/assets/audio/tlo/*

# Makiety gór: moduł i pliki (assets/makiety-gor/ to materiał roboczy, zostaje lokalnie)
!/mountain-fx.js
!/mountain-fx.css
!/assets/web/makiety/*

# Intro sterowane przewijaniem (2026-11-14): moduł i zdjęcia po obróbce (tools/intro.py).
# Oryginały assets/alpinista1–3.jpg i robocze/ zostają lokalnie.
!/intro.js
!/intro.css
!/assets/web/intro/*
# -d.jpg to tylko źródło kart podglądu (tools/og.py) — strona go nie wczytuje
/assets/web/*-d.jpg
