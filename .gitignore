# Do repozytorium (GitHub Pages) trafia tylko gotowa strona.
# Tekst .md, generator (tools/), brief, korekty i oryginały szkiców zostają lokalnie.
*
!*/

!/.gitignore
!/.nojekyll
!/index.html
!/404.html
!/style.css
!/script.js
!/efekty.js
!/efekty.css

!/favicon.svg
!/nie-kazdy-kto-byl-na-szczycie.pdf
!/sitemap.xml
!/feed.xml
!/nie-kazdy-kto-byl-na-szczycie.epub
!/robots.txt

# Strony rozdziałów z podglądem linku — wypisane z nazwy, bo wzorzec !/*/index.html
# wpuszczałby każdy nowy katalog w głównym folderze. Kolejność jak w SLUGS.
!/pilsko/index.html
!/dolina-pieciu-stawow/index.html
!/kozi-wierch/index.html
!/mnich/index.html
!/marmolada/index.html
!/everest/index.html
!/babia-gora/index.html
!/rysy/index.html
!/gran-paradiso/index.html
!/skalka/index.html
!/grossglockner/index.html
!/mont-blanc/index.html

!/fonts/*
!/assets/web/*
!/assets/og/*

# Muzyka do czytania — tylko przekonwertowane pliki, nie oryginały z assets/
!/assets/audio/*
